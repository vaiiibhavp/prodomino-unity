  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022  Uses a 28-tile double-six set or a 56 tile one.\n\r\n\u2022  This
    game is basically a memory test. The aim is to turn over all tiles in pairs so
    that the total pips sum 12.\n\r\n\u2022  If the turned over tiles do not add
    up to 12, then they are turned back down. Player can select two tiles again to
    repeat the process.\n\r\n\u2022  Tiles are removed in pairs and only if its total
    equals 12 pips.\n\r\n\u2022  Players who successfully remove a pair, take an
    extra turn and repeat this process, this happens again and again until the player
    fails to remove a pair which pips equal to 12.\n\r\n\u2022  Try to turn over
    all tiles in the least number of attempts."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b9d61387e0a266b49b0b0ea4d37b33b6, type: 2}
  m_sharedMaterial: {fileID: 5080105675785588487, guid: b9d61387e0a266b49b0b0ea4d37b33b6, type: 2}
